# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection
# If MongoDB is not installed locally, mongodb-memory-server will automatically initialize for instant local dev
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# Authentication & Security
JWT_ACCESS_SECRET=imovies_super_secret_jwt_access_token_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=7d
COOKIE_SECRET=imovies_secure_cookie_signer_secret_key_2026

# Payment Provider Configuration: 'simulated' | 'razorpay' | 'stripe'
PAYMENT_PROVIDER=simulated
PAYMENT_TEST_MODE=true

# Razorpay Sandbox (Optional - required only if PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_secret_key_not_real
PAYMENT_WEBHOOK_SECRET=sample_webhook_secret

# Stripe Sandbox (Optional - required only if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_sample_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_sample_secret

# Admin Initial Seed Credentials (for npm run seed:admin)
ADMIN_SEED_NAME="Cinema SuperAdmin"
ADMIN_SEED_EMAIL=admin@imovies.com
ADMIN_SEED_PASSWORD=Admin@123456
ADMIN_SEED_PHONE=+919876543210

# Logging & Storage
LOG_LEVEL=info
UPLOAD_DIR=uploads

# SMTP Email Verification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vishwakarmanayan66@gmail.com
SMTP_PASS=iywf teod hnet obfq
EMAIL_FROM="IMovies Cinema <noreply@imovies.com>"
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
